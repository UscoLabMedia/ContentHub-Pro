{
  "name": "contenthub-pro",
  "private": true,
  "type": "module",
  "workspaces": ["core", "server", "app", "video"],
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev:server": "npm run dev -w server",
    "dev:app": "npm run dev -w app",
    "video:studio": "npm run studio -w video",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w core",
    "check": "node scripts/check-rules.mjs",
    "verify": "npm run check && npm run typecheck && npm run test"
  },
  "devDependencies": { "typescript": "^5.6.0" }
}
